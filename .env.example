# Automated Sales Pipeline — copy to .env before starting the stack:
#   cp .env.example .env        (Linux / macOS)
#   copy .env.example .env      (Windows)

# --- Slack (recommended) — pipeline failure alerts ---
# Not loaded from .env automatically. After starting the stack, register this
# value as an Airflow Variable (use the same URL you paste below):
#   docker compose exec airflow-webserver airflow variables set slack_webhook_url "<SLACK_WEBHOOK_URL>"
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# --- SMTP (optional) — Airflow built-in email support ---
# Read by docker-compose.yml. Leave blank if you are not using email alerts.
# DAG failure alerts use Slack, not SMTP.
SMTP_EMAIL=user@example.com
SMTP_PASSWORD=your_app_password_here
